# ==============================================================
# LoanLens Environment Configuration
# DISCLAIMER: LoanLens is an awareness and screening aid,
# not legal advice.
# ==============================================================

# Client (Vite React)
VITE_API_URL=http://localhost:5000/api

# Server (Node Express)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/loanlens
ML_SERVICE_URL=http://localhost:8000
JWT_SECRET=loanlens_super_secure_jwt_secret_change_in_production_2026
MAX_FILE_SIZE_MB=15

# ML API (FastAPI)
ML_API_PORT=8000
ML_API_HOST=0.0.0.0
MLFLOW_TRACKING_URI=http://localhost:5001
MODEL_STAGE=Production
MODEL_FALLBACK_PATH=ml-service/models/best_risk_model.joblib

# MLflow Tracking Server
MLFLOW_PORT=5001
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=./mlruns

# Quality Gate Flags
QUALITY_GATE_MIN_MACRO_F1=0.60
QUALITY_GATE_MIN_RISKY_RECALL=0.55
